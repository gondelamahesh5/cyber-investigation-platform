# Flask Configuration
FLASK_CONFIG=production
SECRET_KEY=your-secret-key-here

# Database Configuration
DATABASE_URL=mysql+pymysql://username:password@localhost:3306/database_name

# Application Settings
APP_NAME=Cyber Investigation Platform
APP_URL=http://localhost:5000
API_PREFIX=/api/v1

# Security
CSRF_ENABLED=True
SESSION_COOKIE_SECURE=False
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax
PERMANENT_SESSION_LIFETIME=3600

# File Upload
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=52428800
ALLOWED_EXTENSIONS=pdf,doc,docx,txt,jpg,jpeg,png,gif,zip,rar,eml,pst

# Logging
LOG_LEVEL=INFO
LOG_FOLDER=logs
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=10

# Email Configuration (Optional)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=noreply@example.com
ADMIN_EMAIL=admin@example.com

# Redis (Optional)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Threat Intelligence APIs (Optional)
THREAT_INTEL_API_KEY=
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
SHODAN_API_KEY=
CENSYS_API_ID=
CENSYS_API_SECRET=

# Encryption
ENCRYPTION_KEY=your-32-byte-encryption-key

# Rate Limiting
RATELIMIT_ENABLED=True
RATELIMIT_STORAGE_URL=redis://localhost:6379/0
RATELIMIT_STRATEGY=fixed-window
RATELIMIT_DEFAULT=100 per hour
RATELIMIT_LOGIN=5 per 15 minutes

# Backup
BACKUP_FOLDER=backups
BACKUP_RETENTION_DAYS=30
AUTO_BACKUP_ENABLED=True
AUTO_BACKUP_SCHEDULE=0 2 * * *

# AI Configuration
AI_CONFIDENCE_THRESHOLD=0.7
AI_ENTITY_EXTRACTION_ENABLED=True
AI_SUMMARIZATION_ENABLED=True
AI_LINK_ANALYSIS_ENABLED=True

# Feature Flags
ENABLE_REGISTRATION=True
ENABLE_EMAIL_VERIFICATION=False
ENABLE_TWO_FACTOR=False
ENABLE_API_ACCESS=True
ENABLE_BULK_UPLOAD=True

# Monitoring (Optional)
SENTRY_DSN=
NEW_RELIC_LICENSE_KEY=
NEW_RELIC_APP_NAME=Cyber Investigation Platform

# Development
DEBUG=False
TESTING=False
SQLALCHEMY_ECHO=False
SQLALCHEMY_POOL_SIZE=10
SQLALCHEMY_POOL_RECYCLE=3600

# CORS
CORS_ORIGINS=*
CORS_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOW_HEADERS=Content-Type,Authorization,X-Requested-With